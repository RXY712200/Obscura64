@PACKAGE_INIT@

if("@OBSCURA64_VERSION_PRERELEASE@" STREQUAL "")
    set(Obscura64_VERSION_FULL "@PROJECT_VERSION@")
else()
    set(Obscura64_VERSION_FULL "@PROJECT_VERSION@-@OBSCURA64_VERSION_PRERELEASE@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Obscura64Targets.cmake")
check_required_components(Obscura64)
